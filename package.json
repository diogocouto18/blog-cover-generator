{
  "name": "blog-cover-generator",
  "version": "1.0.0",
  "description": "Generate blog post cover images from a Heroicons icon, no AI/paid image generation service required.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "generate": "tsx generate-cover.ts",
    "postinstall": "playwright-core install chromium",
    "typecheck": "tsc",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "heroicons": "^2.2.0",
    "playwright-core": "^1.61.1"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.10.0"
  }
}
